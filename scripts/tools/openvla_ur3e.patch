+_TOKENIZER_PAYLOAD_FILES = ("tokenizer.json", "tokenizer.model")
+_WEIGHT_FILES = ("model.safetensors", "pytorch_model.bin")
+_WEIGHT_INDEX_FILES = ("model.safetensors.index.json", "pytorch_model.bin.index.json")
