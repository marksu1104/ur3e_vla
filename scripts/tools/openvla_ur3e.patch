+
+def _is_nonempty_file(path: Path) -> bool:
+    return path.is_file() and path.stat().st_size > 0
+
+
+def _require_complete_model_dir(model_dir: Path) -> None:
+    """Reject an export that the inference server cannot load completely."""
+    missing = [name for name in _REQUIRED_FINAL_MODEL_FILES if not _is_nonempty_file(model_dir / name)]
+    if not any(_is_nonempty_file(model_dir / name) for name in _TOKENIZER_PAYLOAD_FILES):
+        missing.append("tokenizer.json|tokenizer.model")
+
+    index_paths = [model_dir / name for name in _WEIGHT_INDEX_FILES if _is_nonempty_file(model_dir / name)]
+    if index_paths:
+        for index_path in index_paths:
+            try:
+                weight_map = json.loads(index_path.read_text()).get("weight_map", {})
+            except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
+                raise RuntimeError(f"Invalid weight index {index_path.name}: {error}") from error
+            shards = set(weight_map.values())
+            if not shards:
+                raise RuntimeError(f"Invalid weight index {index_path.name}: empty weight_map")
+            missing.extend(
+                f"{index_path.name}:{name}" for name in sorted(shards)
+                if not _is_nonempty_file(model_dir / name)
+            )
+    elif not any(_is_nonempty_file(model_dir / name) for name in _WEIGHT_FILES):
+        missing.append("model.safetensors|pytorch_model.bin|weight index")
+
+    if missing:
+        raise RuntimeError(f"Incomplete final model export; missing or empty: {', '.join(missing)}")
+    for name in _REQUIRED_FINAL_MODEL_FILES:
+        try:
+            json.loads((model_dir / name).read_text())
+        except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
+            raise RuntimeError(f"Invalid JSON in final model export {name}: {error}") from error
+
+
+def _publish_final_model(model, processor, dataset_statistics, final_model_dir: Path) -> None:
+    """Write a complete sibling staging directory, then atomically publish it."""
+    final_model_dir = Path(final_model_dir)
+    if os.path.lexists(final_model_dir):
+        raise FileExistsError(f"Final model directory already exists: {final_model_dir}")
+    final_model_dir.parent.mkdir(parents=True, exist_ok=True)
+    staging_dir = Path(tempfile.mkdtemp(prefix=f".{final_model_dir.name}.staging-", dir=final_model_dir.parent))
+    try:
+        save_dataset_statistics(dataset_statistics, staging_dir)
+        processor.save_pretrained(staging_dir)
+        model.save_pretrained(staging_dir)
+        _require_complete_model_dir(staging_dir)
+        if os.path.lexists(final_model_dir):
+            raise FileExistsError(f"Final model directory appeared during export: {final_model_dir}")
+        staging_dir.rename(final_model_dir)
+    except BaseException:
+        shutil.rmtree(staging_dir, ignore_errors=True)
+        raise
+
 
